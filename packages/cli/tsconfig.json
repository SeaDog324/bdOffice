{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "paths": {
      "@genoffice/doc2docx": [
        "../doc2docx/src/index.ts"
      ],
      "@genoffice/docx-engine": [
        "../docx-engine/src/index.ts"
      ],
      "@genoffice/pptx-engine": [
        "../pptx-engine/src/index.ts"
      ],
      "@genoffice/pdf2docx": [
        "../pdf2docx/src/index.ts"
      ],
      "@genoffice/pptx-ops": [
        "../pptx-ops/src/index.ts"
      ],
      "@genoffice/pptx-render": [
        "../pptx-render/src/index.ts"
      ],
      "@genoffice/pipelines/slides": [
        "../pipelines/src/slides/index.ts"
      ],
      "@genoffice/pptx-ops/op-docs": [
        "../pptx-ops/src/op-docs.ts"
      ],
      "@genoffice/pptx-ops/font-size": [
        "../pptx-ops/src/font-size.ts"
      ],
      "@genoffice/xlsx-gateway/*": [
        "../xlsx-gateway/src/*"
      ],
      "@genoffice/font-metrics": [
        "../font-metrics/src/index.ts"
      ],
      "@genoffice/electron-utils": [
        "../electron-utils/src/index.ts"
      ],
      "@genoffice/electron-utils/*": [
        "../electron-utils/src/*"
      ],
      "@genoffice/ai-search": [
        "../ai-search/src/index.ts"
      ],
      "@genoffice/ai-provider": [
        "../ai-provider/src/index.ts"
      ],
      "@genoffice/ai-provider/browser": [
        "../ai-provider/src/browser.ts"
      ],
      "@genoffice/i18n": [
        "../i18n/src/index.ts"
      ],
      "@genoffice/ui": [
        "../ui/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../pdf2docx/src/bidi-js.d.ts",
    "../pptx-ops/src/raw.d.ts",
    "../../apps/docs/src/renderer/env.d.ts",
    "../../apps/markdown/src/renderer/env.d.ts",
    "../../apps/markdown/src/renderer/types/wavedrom.d.ts"
  ]
}

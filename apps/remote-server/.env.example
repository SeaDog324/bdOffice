# Copy to an ignored .env file; set a unique account and a long random password.
REMOTE_ACCOUNT=
REMOTE_PASSWORD=
# Local profile: http://127.0.0.1:48300. Public profile: https://your-domain.
REMOTE_PUBLIC_URL=http://127.0.0.1:48300
REMOTE_DOMAIN=
TURN_PUBLIC_IP=
TURN_URLS=
TURN_SHARED_SECRET=
# Only this configured origin may receive UnifiedPush wake-up requests.
PUSH_ORIGIN=

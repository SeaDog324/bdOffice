{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@genoffice/docx-engine": [
        "../../packages/docx-engine/src/index.ts"
      ],
      "@genoffice/font-metrics": [
        "../../packages/font-metrics/src/index.ts"
      ],
      "@genoffice/font-metrics/resolve": [
        "../../packages/font-metrics/src/resolve.ts"
      ],
      "@genoffice/font-metrics/word-faces.json": [
        "../../packages/font-metrics/word-faces.json"
      ],
      "@genoffice/electron-utils/headless-export": [
        "../../packages/electron-utils/src/headless-export.ts"
      ],
      "@genoffice/electron-utils/atomic-write": [
        "../../packages/electron-utils/src/atomic-write.ts"
      ],
      "@genoffice/electron-utils": [
        "../../packages/electron-utils/src/index.ts"
      ],
      "@genoffice/ai-provider": [
        "../../packages/ai-provider/src/index.ts"
      ],
      "@genoffice/agent-core": [
        "../../packages/agent-core/src/index.ts"
      ],
      "@genoffice/i18n": [
        "../../packages/i18n/src/index.ts"
      ],
      "@genoffice/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@genoffice/xlsx-gateway/*": [
        "../../packages/xlsx-gateway/src/*"
      ]
    }
  },
  "include": [
    "src",
    "electron.vite.config.ts"
  ]
}
